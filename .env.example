# LLM dual-track (optional). Copy to `.env` and fill real values. Never commit `.env`.

# Primary — 阿里云 Token Plan (OpenAI compatible)
# TOKENHUB_API_KEY=
# TOKENHUB_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# TOKENHUB_MODEL=qwen3.8-max-preview

# Fallback — SenseNova
# SENSENOVA_API_KEY=
# SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
# SENSENOVA_MODEL=sensenova-6.7-flash-lite

# Optional DashScope / generic
# DASHSCOPE_API_KEY=
# LLM_API_KEY=
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# Without keys: /api/health → enhanced.demo_ready=false; UI stays on rules.
# Studio static Demo: use in-page「增强配置」(sessionStorage) for live enhanced demos.
